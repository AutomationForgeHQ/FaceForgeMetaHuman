{
  "FileVersion": 3,
  "Version": 3,
  "VersionName": "0.2.2",
  "FriendlyName": "FaceForge - MetaHuman Solver",
  "Description": "Registers UE 5.8's own audio-driven animation solver with FaceForge. Free, local, offline: a sound wave in, 81 MetaHuman face-board control curves out, with no MetaHuman asset required anywhere. This is the only module that links the MetaHuman plugin - remove it and FaceForge still loads, with one fewer solver.",
  "Category": "Automation Forge",
  "CreatedBy": "Bojan Andrejek",
  "CreatedByURL": "https://kovati.dev",
  "DocsURL": "https://github.com/AutomationForgeHQ/FaceForgeMetaHuman",
  "MarketplaceURL": "",
  "SupportURL": "https://github.com/AutomationForgeHQ/FaceForgeMetaHuman/issues",
  "EditorOnly": true,
  "EnabledByDefault": false,
  "CanContainContent": false,
  "IsBetaVersion": true,
  "IsExperimentalVersion": false,
  "Installed": false,
  "Modules": [
    {
      "Name": "FaceForgeMetaHuman",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "TargetAllowList": [
        "Editor"
      ]
    },
    {
      "Name": "FaceForgeMetaHumanVideo",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "TargetAllowList": [
        "Editor"
      ]
    }
  ],
  "Plugins": [
    {
      "Name": "FaceForge",
      "Enabled": true
    },
    {
      "Name": "MetaHuman",
      "Enabled": true
    },
    {
      "Name": "StreamingADA",
      "Enabled": true
    },
    {
      "Name": "CaptureData",
      "Enabled": true,
      "Comment": "UFootageCaptureData, the asset the video solve reads footage through."
    },
    {
      "Name": "ImgMedia",
      "Enabled": true,
      "Comment": "UImgMediaSource, the image-sequence source inside the footage asset."
    },
    {
      "Name": "ToolsetRegistry",
      "Enabled": true,
      "Comment": "The video module publishes its one tool through the registry."
    }
  ]
}
